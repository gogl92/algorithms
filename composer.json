{
    "name": "gogl92/cfdi-sat",
    "description": "SAT CFDI integration for Laravel applications",
    "type": "library",
    "require": {
        "guzzlehttp/guzzle": "^7.0",
        "phpcfdi/sat-ws-descarga-masiva": "^0.5",
        "phpcfdi/cfditopdf": "dev-master"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Gogl92\\CfdiSat\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Luis Gonzalez",
            "email": "luisarmando1234@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Gogl92\\CfdiSat\\CfdiServiceProvider"
            ],
            "aliases": {
                "Cfdi": "Gogl92\\CfdiSat\\Facades\\Cfdi"
            }
        }
    }
}
